{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Imlight.Director/bin/Debug/net10.0/Imlight.Director.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Imlight.Director",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "logging": {
                "moduleLoad": false
            },
            "requireExactSource": false,
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
