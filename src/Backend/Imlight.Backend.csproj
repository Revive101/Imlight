<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config\akka.conf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\akka.conf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Content\serverdata" />
    <Content Include="Config\Imlight.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Content\serverdata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Certificates\base" />
    <Content Include="Certificates\base">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Config\Imlight.ini" />
    <None Remove="Certificates\worlddata.client.certificate.pfx" />
    <Content Include="Certificates\worlddata.client.certificate.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.0" />
    <PackageReference Include="Akka.Remote" Version="1.5.0" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Imlight.Common.csproj" />
    <ProjectReference Include="..\Server\Imlight.Server.csproj" />
  </ItemGroup>

</Project>
