    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.CodeDom" Version="7.0.0" />
    <PackageReference Include="WizUnraveler" Version="1.3.9.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imlight.Common\Imlight.Common.csproj" />
    <ProjectReference Include="..\Imlight.Game\Imlight.Game.csproj" />
    <ProjectReference Include="..\Imlight.Login\Imlight.Login.csproj" />
    <ProjectReference Include="..\Imlight.Resources\Imlight.Resources.csproj" />
  </ItemGroup>

</Project>
